# Application
NODE_ENV=development
PORT=3000
ALLOWED_ORIGINS=http://localhost:3000

# Database
DATABASE_URL=postgresql://streeteye:password@localhost:5432/streeteye
DB_PASSWORD=password

# Redis
REDIS_URL=redis://localhost:6379

# JWT
JWT_ACCESS_SECRET=change-me-to-a-random-64-char-string-in-production-abc123
JWT_REFRESH_SECRET=change-me-to-another-random-64-char-string-in-production-xyz789
JWT_ACCESS_TTL=900
JWT_REFRESH_TTL=2592000

# Email (Resend)
RESEND_API_KEY=re_xxxxxxxxxxxx
RESEND_FROM=noreply@streeteye.app

# App links (used in email templates)
APP_BASE_URL=http://localhost:3000

# Localisation
DEFAULT_LOCALE=en
SUPPORTED_LOCALES=en,ru
