generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── Enums ───────────────────────────────────────────────────────────────────

enum Locale {
  EN
  RU
}

enum Level {
  BEGINNER
  INTERMEDIATE
  PRO
}

enum Category {
  VISUAL
  TECHNICAL
  SOCIAL
  RESTRICTION
}

enum SessionStatus {
  ACTIVE
  COMPLETED
  SKIPPED
  SAVED_FOR_LATER
}

enum SelfRating {
  FAILED
  PARTIAL
  SUCCESS
}

enum EmailTokenType {
  VERIFY_EMAIL
  RESET_PASSWORD
}

// ─── Models ──────────────────────────────────────────────────────────────────

model User {
  id                  String     @id @default(uuid())
  email               String     @unique
  passwordHash        String
  isEmailVerified     Boolean    @default(false)
  locale              Locale     @default(EN)
  level               Level      @default(BEGINNER)
  preferredCategories Category[]
  createdAt           DateTime   @default(now())
  updatedAt           DateTime   @updatedAt

  refreshTokens  RefreshToken[]
  emailTokens    EmailToken[]
  taskSessions   TaskSession[]
  journalEntries JournalEntry[]
  userBadges     UserBadge[]

  @@map("users")
}

model RefreshToken {
  id        String   @id @default(uuid())
  tokenHash String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
  @@map("refresh_tokens")
}

model EmailToken {
  id        String         @id @default(uuid())
  tokenHash String         @unique
  userId    String
  user      User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      EmailTokenType
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime       @default(now())

  @@index([userId])
  @@map("email_tokens")
}

model Task {
  id             String   @id @default(uuid())
  title_ru       String
  title_en       String
  description_ru String
  description_en String
  tip_ru         String
  tip_en         String
  category       Category
  level          Level
  durationMins   Int
  tags           String[]
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())

  sessions TaskSession[]

  @@map("tasks")
}

model TaskSession {
  id          String        @id @default(uuid())
  userId      String
  user        User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  taskId      String
  task        Task          @relation(fields: [taskId], references: [id])
  status      SessionStatus
  startedAt   DateTime      @default(now())
  completedAt DateTime?

  journalEntry JournalEntry?

  @@index([userId])
  @@index([userId, status])
  @@map("task_sessions")
}

model JournalEntry {
  id         String     @id @default(uuid())
  userId     String
  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  sessionId  String     @unique
  session    TaskSession @relation(fields: [sessionId], references: [id])
  note       String?    @db.VarChar(500)
  selfRating SelfRating
  hasPhoto   Boolean    @default(false)
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt

  @@index([userId])
  @@map("journal_entries")
}

model Badge {
  id          String      @id @default(uuid())
  key         String      @unique
  name        String
  description String

  userBadges UserBadge[]

  @@map("badges")
}

model UserBadge {
  id       String   @id @default(uuid())
  userId   String
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  badgeId  String
  badge    Badge    @relation(fields: [badgeId], references: [id])
  earnedAt DateTime @default(now())

  @@unique([userId, badgeId])
  @@map("user_badges")
}
